# Dependencies (Never push these)
/node_modules
/vendor

# Environment & Secrets (Never push database credentials or keys)
.env
.env.backup
.env.production
.env.local
.env.*.local

# Laravel Runtime, Cache & Uploaded Media
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/app/public/hotels/*
/storage/app/public/rooms/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*.log
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Testing & Package Locks/Caches
.phpunit.result.cache
.phpunit.cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/

# Editor & OS Files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp